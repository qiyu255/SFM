name "蜜蜂生产"
-- updated at %{now()}

every 20 ticks do 
   input fe:: from power
   output fe:: to "离心"
   output fe:: to "热离"
end

every 20 ticks do 
   -- 玻璃瓶
   input from raw
   output to "蜂箱"
   forget

   
   input from "蜂箱"
   -- 蜜皮 
   output productivebees:configurable_honeycomb to "离心"
   -- 块 
   output productivebees:configurable_comb to "热离"
   output except productivebees:configurable_honeycomb,
      productivebees:configurable_comb  to cooked
   forget

   -- 收集
   input fluid:: from "离心","热离"
   output fluid:: to "盆","储罐"
   input item:: from "离心","热离","盆" east side
   output item:: to cooked 
end