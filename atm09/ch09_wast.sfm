name "核废料处理"
-- updated at %{now()}

every 20 ticks do 
   input fe:: from power
   output fe:: to "粉碎",
   "Puz",
   "Poz",
   "Pu" north side
end

every 520 ticks do 
   if "核废料" has > 128000 gas:: then
      input gas:: from "核废料" north side
      output 64000 gas:: to "分流" east side slots 0
      output 64000 gas:: to "分流" east side slots 1
      forget
   end
end

every 60 ticks do 

   input gas:: from "分流" north side slots 0
   output gas:: to Po east side
   forget   

   input gas:: from "分流" north side slots 1
   output gas:: to Pu east side
   forget

   input from box slots 2 -- 氟石
   output to "粉碎" top side
   forget

   input fluid:: from "水"
   output fluid:: to Poz,Puz west side
   input from "粉碎" east side
   output to Poz,Puz west side
   forget
   
   input gas:: from Po south side
   output gas:: to Poz top side
   forget
   input gas:: from Pu south side
   output gas:: to Puz top side
   forget

   input item:: from Poz,Puz east side
   output item:: to save
   input gas:: from Poz,Puz east side
   output gas:: to "废料桶" top side
end
